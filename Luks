## 5. System Configuration & Package Initialization
```bash
emerge-webrsync
getuto

# Choose your profile (23.0 Hardened OpenRC)
eselect profile set default/linux/amd64/23.0/hardened

# Optimize CPU flags globally
emerge --ask --oneshot app-portage/cpuid2cpuflags
echo "*/* $(cpuid2cpuflags)" > /etc/portage/package.use/00cpu-flags

# Update world set to match profile changes
emerge -avuDUg @world
emerge --ask --depclean

# Unmask and accept keywords for Clevis/TPM2 stacks
mkdir -p /etc/portage/package.accept_keywords
echo "app-crypt/clevis" >> /etc/portage/package.accept_keywords/clevis
echo "app-crypt/tpm2-tools" >> /etc/portage/package.accept_keywords/clevis
echo "sys-boot/limine" >> /etc/portage/package.accept_keywords/limine

# Install baseline packages, adding sys-boot/limine, clevis, and tpm2 tools
emerge --ask app-editors/nano net-misc/networkmanager sys-fs/btrfs-progs sys-fs/cryptsetup sys-kernel/linux-firmware sys-firmware/sof-firmware sys-apps/apparmor sec-policy/apparmor-profiles sys-boot/limine app-crypt/clevis app-crypt/tpm2-tools
```

